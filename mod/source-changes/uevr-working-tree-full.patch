+bool WuWaControlsComponent::status_warning_visible() const {
+    // A visible card shows both recovery states itself. The VR menu's cinematic
+    // note, the first-launch tip and the view chip show for a few seconds, but
+    // a card you are holding up comes first.
+    if (g_framework->is_drawing_ui() || !VR::get()->is_hmd_active()) return false;
+    wuwa_sheet::CardState held;
+    if (m_cards->value() && held_card(held)) return false;
+    return wuwa_menu_host::hint_active() || tip_kind() != 0 ||
+        (!floor_visible() && (menu_warning_active() || mode_warning_active()));
+}
+
+namespace {
+// The system cursor over the game window, in client pixels (ImGui's DisplaySize); false outside it.
+bool vr_cursor_position(ImVec2& out) {
+    const auto window = g_framework->get_window();
+    POINT point{};
+    RECT client{};
+    if (window == nullptr || !GetCursorPos(&point) || !ScreenToClient(window, &point) || !GetClientRect(window, &client)) return false;
+    if (point.x < 0 || point.y < 0 || point.x >= client.right || point.y >= client.bottom) return false;
+    out = {(float)point.x, (float)point.y};
+    return true;
+}
+
+// The cursor shows for a while after the mouse last moved, so a controller player's menus stay clean,
+// and hides at once on controller input until the mouse moves again (the game shows its own ring).
+bool vr_cursor_moved_recently() {
+    static std::atomic<uint64_t> last_position{UINT64_MAX}, moved_at{};
+    POINT point{};
+    if (!GetCursorPos(&point)) return false;
+    const auto packed = (uint64_t)(uint32_t)point.x << 32 | (uint32_t)point.y;
+    const auto now = GetTickCount64();
+    if (last_position.exchange(packed, std::memory_order_relaxed) != packed) moved_at.store(now, std::memory_order_relaxed);
+    const auto moved = moved_at.load(std::memory_order_relaxed);
+    return moved != 0 && now - moved <= 10000 && moved > wuwa_input_activity::last_gamepad();
+}
+
+// A classic arrow, tip at the hot spot, outlined so it reads on light and dark UI.
+void draw_vr_cursor(ImDrawList* list, ImVec2 tip, float scale) {
+    const auto at = [&](float x, float y) { return ImVec2{tip.x + x * scale, tip.y + y * scale}; };
+    const ImVec2 outline[]{at(0, 0), at(0, 17), at(4, 13), at(7, 19.5f), at(9.5f, 18.5f), at(6.5f, 12), at(12, 12)};
+    const ImVec2 head[]{at(0, 0), at(0, 17), at(4, 13), at(6.5f, 12), at(12, 12)};
+    const ImVec2 tail[]{at(4, 13), at(7, 19.5f), at(9.5f, 18.5f), at(6.5f, 12)};
+    const auto white = IM_COL32(255, 255, 255, 255), black = IM_COL32(0, 0, 0, 255);
+    list->AddConvexPolyFilled(head, IM_ARRAYSIZE(head), white);
+    list->AddConvexPolyFilled(tail, IM_ARRAYSIZE(tail), white);
+    list->AddPolyline(outline, IM_ARRAYSIZE(outline), black, ImDrawFlags_Closed, std::max(1.5f, scale * 0.9f));
+}
+}
+
+bool WuWaControlsComponent::mouse_in_use() const {
+    // The game itself shows its cursor (menus, Alt) and the mouse moved lately.
+    if (!wuwa_test::is_wuwa() || g_framework->get_window() == nullptr) return false;
+    if (!fresh_menu_cursor() || !vr_cursor_moved_recently()) return false;
+    DWORD process{};
+    GetWindowThreadProcessId(GetForegroundWindow(), &process);
+    ImVec2 position{};
+    return process == GetCurrentProcessId() && vr_cursor_position(position);
+}
+
+bool WuWaControlsComponent::cursor_visible() const {
+    // Only over the game UI panel: never with a menu, warning or held card using the overlay.
+    if (!wuwa_test::is_wuwa() || g_framework->get_window() == nullptr || g_framework->is_drawing_ui()) return false;
+    auto& vr = VR::get();
+    if (!vr->is_hmd_active() || !vr->is_gui_enabled() || status_warning_visible() || floor_visible()) return false;
+    return mouse_in_use();
+}
+
+bool WuWaControlsComponent::floor_visible() const {
+    // A guided test plan uses the card's place for its current step. The overlay is one panel, so
+    // the step card, like the pinned card, steps aside while the mouse is in use (test 16: with
+    // either one up the VR cursor never showed).
+    return wuwa_test::is_wuwa() && !g_framework->is_drawing_ui() && VR::get()->is_hmd_active() &&
+        (card_visible() || (wuwa_menu_host::overlay_wanted() && !mouse_in_use()));
+}
+
+namespace {
+// The card rises into place, and sinks away when let go.
+constexpr uint64_t card_rise_ms = 180, card_sink_ms = 160;
+}
+
+float WuWaControlsComponent::floor_width() const { return card_visible() ? m_card_width->value() : 1.5f; }
+
+bool WuWaControlsComponent::held_card(wuwa_sheet::CardState& state) const {
+    const auto text = m_card.get();
+    char kind[8]{};
+    unsigned buttons{};
+    int lt{}, rt{};
+    if (text.empty() || std::sscanf(text.c_str(), "%7[a-z0-9]:%u:%d:%d", kind, &buttons, &lt, &rt) != 4) return false;
+    state.card = std::string_view{kind} == "views" ? wuwa_sheet::Card::views : wuwa_sheet::Card::l3;
+    state.buttons = buttons;
+    state.lt = lt != 0;
+    state.rt = rt != 0;
+    return true;
+}
+
+namespace {
+// How many view switches show the hint before it switches itself off.
+constexpr int view_hint_count = 5;
+}
+
+bool WuWaControlsComponent::card_visible() const {
+    const bool eligible = wuwa_test::is_wuwa() && m_cards->value() && !g_framework->is_drawing_ui() && VR::get()->is_hmd_active();
+    wuwa_sheet::CardState state;
+    // A loaded test plan's step keeps the card's place unless you hold a card up. A pinned
+    // card sinks while the mouse is in use, so the VR cursor can use the overlay, and rises
+    // again 10 s after the mouse stops.
+    const bool holding = eligible && held_card(state);
+    const bool wanted = eligible && (holding || (m_pin_card->value() && !wuwa_menu_host::overlay_wanted() && !mouse_in_use()));
+    const auto now = GetTickCount64();
+    std::scoped_lock lock{m_card_mutex};
+    if (!eligible) {
+        m_card_up = false;
+        m_card_released = 0;
+        return false;
+    }
+    if (wanted) {
+        // A pinned card follows when you turn well away from it: it rises again
+        // in front of you.
+        bool follow = false;
+        if (m_card_up && !holding) {
+            glm::vec3 back{};
+            card_anchor(back);
+            follow = glm::dot(back, m_card_back) < 0.5f;
+        }
+        if (!m_card_up || follow) {
+            m_card_up = true;
+            m_card_since = now;
+            m_card_anchor = card_anchor(m_card_back);
+        }
+        m_card_released = 0;
+        return true;
+    }
+    if (m_card_up) {
+        m_card_up = false;
+        m_card_released = now;
+    }
+    return m_card_released != 0 && now - m_card_released < card_sink_ms;
+}
+
+Matrix4x4f WuWaControlsComponent::card_anchor(glm::vec3& out_back) const {
+    // Where the head faces when the card is called up, level, below the line of
+    // sight (Card height) and tilted to face the eyes. It then stays put, so a
+    // glance down reads it and looking around leaves it behind.
+    auto& vr = VR::get();
+    const auto head = vr->get_transform(vr->get_hmd_index());
+    glm::vec3 back{head[2].x, 0.0f, head[2].z};
+    // Looking straight down: the top of the head points forward.
+    if (glm::length(back) < 0.2f) back = glm::vec3{-head[1].x, 0.0f, -head[1].z};
+    if (glm::length(back) < 0.01f) back = glm::vec3{0.0f, 0.0f, 1.0f};
+    back = glm::normalize(back);
+    out_back = back;
+    const glm::vec3 up{0.0f, 1.0f, 0.0f}, right = glm::cross(up, back);
+    Matrix4x4f basis{1.0f};
+    basis[0] = glm::vec4{right, 0.0f};
+    basis[1] = glm::vec4{up, 0.0f};
+    basis[2] = glm::vec4{back, 0.0f};
+    const float distance = m_card_distance->value(), below = glm::radians(m_card_below->value());
+    auto transform = basis * glm::rotate(-below, glm::vec3{1.0f, 0.0f, 0.0f});
+    const glm::vec3 eye{head[3]};
+    transform[3] = glm::vec4{eye - back * (distance * std::cos(below)) - up * (distance * std::sin(below)), 1.0f};
+    return transform;
+}
+
+int WuWaControlsComponent::tip_kind() const {
+    if (!wuwa_test::is_wuwa() || !m_cards->value()) return 0;
+    const auto now = GetTickCount64();
+    auto& vr = VR::get();
+    const int view = vr->is_using_mono_theatre() ? 2 : vr->is_using_2d_screen() ? 1 : 0;
+    {
+        // After a view switch: what you are in and how to get back, for 3 seconds,
+        // for the first five switches. The fifth turns View hints off.
+        std::scoped_lock lock{m_card_mutex};
+        if (m_view_seen >= 0 && view != m_view_seen && m_view_hints->value()) {
+            m_view_chip_until = now + 3000;
+            m_view_hint = (std::max)(m_view_hints_shown->value(), 0) + 1;
+            if (m_view_hint >= view_hint_count) {
+                m_view_hints->value() = false;
+                m_view_hints_shown->value() = 0;
+            } else {
+                m_view_hints_shown->value() = m_view_hint;
+            }
+            g_framework->deferred_save_config();
+        }
+        m_view_seen = view;
+        if (now < m_view_chip_until) return 2;
+    }
+    return now < m_tip_until.load() ? 1 : 0;
+}
+
+void WuWaControlsComponent::update_tip() {
+    // On the first three launches, one line under your view once play has
+    // started (script reporting, headset on, no menus), for 12 seconds.
+    if (m_tip_done || !wuwa_test::is_wuwa()) return;
+    if (!m_cards->value() || m_tips_shown->value() >= 3) {
+        m_tip_done = true;
+        return;
+    }
+    bool playing = game_focused() && VR::get()->is_hmd_active() && !menu_warning_active();
+    {
+        std::scoped_lock lock{m_bridge_mutex};
+        playing = playing && !m_game_menu && m_received != std::chrono::steady_clock::time_point{} &&
+            std::chrono::steady_clock::now() - m_received <= std::chrono::milliseconds(1000);
+    }
+    const auto now = GetTickCount64();
+    if (!playing) {
+        m_tip_eligible_since = 0;
+        return;
+    }
+    if (m_tip_eligible_since == 0) m_tip_eligible_since = now;
+    if (now - m_tip_eligible_since < 4000) return;
+    m_tip_until.store(now + 12000);
+    m_tip_done = true;
+    m_tips_shown->value() = m_tips_shown->value() + 1;
+    g_framework->deferred_save_config();
+}
+
+void WuWaControlsComponent::refresh_recording_live() {
+    m_video.poll(Framework::get_persistent_dir());
+    const auto state=m_video.state();
+    // Starting and finishing count too: frames are captured around both.
+    m_recording_live.store(state=="starting" || state=="recording" || state=="finishing" ||
+        (m_video.pending() && m_recording_live.load(std::memory_order_relaxed)),std::memory_order_relaxed);
+}
+
+std::string WuWaControlsComponent::menu_recording_state() {
+    refresh_recording_live();
+    if (!m_video.connected()) return "offline";
+    if (!m_video.available()) return "unavailable";
+    return m_video.pending() ? "waiting" : m_video.state();
+}
+
+void WuWaControlsComponent::menu_recording_toggle() {
+    const auto profile=Framework::get_persistent_dir();
+    m_video.poll(profile,true);
+    const auto state=m_video.state();
+    if (state=="starting" || state=="recording") { m_video.submit(profile,false); return; }
+    constexpr int rates[]{30,45,60},widths[]{720,1024,1280};
+    // Cover the IDs from the request on, before the launcher reports "starting".
+    if (m_video.submit(profile,true,rates[std::clamp(m_video_fps->value(),0,2)],
+                  widths[std::clamp(m_video_width->value(),0,2)],m_video_telemetry->value(),
+                  m_video_style->value()==1))
+        m_recording_live.store(true,std::memory_order_relaxed);
+}
+
+Matrix4x4f WuWaControlsComponent::floor_transform() const {
+    if (card_visible()) {
+        Matrix4x4f anchor;
+        uint64_t since{}, released{};
+        {
+            std::scoped_lock lock{m_card_mutex};
+            anchor = m_card_anchor;
+            since = m_card_since;
+            released = m_card_released;
+        }
+        const auto now = GetTickCount64();
+        float lower = released != 0 ? std::clamp((now - released) / float(card_sink_ms), 0.0f, 1.0f)
+            : 1.0f - std::clamp((now - since) / float(card_rise_ms), 0.0f, 1.0f);
+        lower = lower * lower * (3.0f - 2.0f * lower);
+        anchor[3] -= glm::vec4{0.0f, 0.12f * lower, 0.0f, 0.0f};
+        return anchor;
+    }
+    // A test plan's step card: below the recentered headset origin, tilted up.
+    const auto basis = Matrix4x4f{glm::inverse(VR::get()->get_rotation_offset())};
+    const auto center = Vector3f{VR::get()->get_standing_origin()} - Vector3f{basis[2]} * 0.65f - Vector3f{0.0f, 1.2f, 0.0f};
+    auto transform = basis * glm::rotate(glm::radians(-60.0f), Vector3f{1.0f, 0.0f, 0.0f});
+    transform[3] = glm::vec4{center, 1.0f};
+    return transform;
+}
+
+namespace {
+// Settings that belong to other mods (the portal), by config key.
+bool setting_on(std::string_view key) {
+    for (auto& mod : g_framework->get_mods()->get_mods()) {
+        if (auto* value = mod->get_value(key)) {
+            const auto text = value->get();
+            return text == "true" || text == "1";
+        }
+    }
+    return false;
+}
+}
+
+void WuWaControlsComponent::draw_passive_overlay() {
+    // Recordings started from the launcher window are seen here (twice a second).
+    if (wuwa_test::is_wuwa()) refresh_recording_live();
+    update_tip();
+    auto* list=ImGui::GetBackgroundDrawList();
+    const auto size=ImGui::GetIO().DisplaySize;
+    auto& vr=VR::get();
+    const bool vr_controllers=vr->is_using_controllers();
+    const int view=vr->is_using_mono_theatre() ? 2 : vr->is_using_2d_screen() ? 1 : 0;
+    if (status_warning_visible()) {
+        if (!floor_visible() && (menu_warning_active() || mode_warning_active())) {
+            const bool hidden=menu_warning_active();
+            const bool shortcut=m_enabled->value() && !vr->physical_gamepad_passthrough();
+            if (hidden) wuwa_sheet::draw_hidden_ui_warning(list,size,ImGui::GetFont(),shortcut,true);
+            if (mode_warning_active()) wuwa_sheet::draw_mouse_mode_warning(list,size,ImGui::GetFont(),m_adjust.value(),hidden);
+        } else if (wuwa_menu_host::hint_active()) {
+            wuwa_menu_host::draw_hint(list,size);
+        } else if (tip_kind()==2) {
+            static constexpr const char* names[]{N_("Full VR"),N_("Stereo screen"),N_("Mono theatre")};
+            char note[512]{};
+            std::snprintf(note,sizeof(note),wuwa_l10n::translate(
+                "Hint %d of %d. It then switches off; View hints on the WuWa VR menu's HUD page turns it back on.").c_str(),
+                m_view_hint,view_hint_count);
+            wuwa_sheet::draw_tip(list,size,ImGui::GetFont(),names[view],
+                view==0 ? "{LT}+{RT}, click {R3} for the stereo screen" : view==1 ? "{LT}+{RT}, click {R3} for full VR" :
+                "{LT}+{RT}, hold {R3} to leave mono",vr_controllers,
+                wuwa_l10n::visual(note));
+        } else {
+            wuwa_sheet::draw_tip(list,size,ImGui::GetFont(),"New:",
+                "hold {L3} or {LT}+{RT} to see what each button does \xC2\xB7 {L3}+{R3} opens the WuWa VR menu",vr_controllers);
+        }
+        return;
+    }
+    wuwa_menu_host::tick();
+    if (!floor_visible()) {
+        ImVec2 position{};
+        // About the flat game's cursor size at 1440 lines; DisplaySize is the window's client area.
+        if (cursor_visible() && vr_cursor_position(position)) draw_vr_cursor(list, position, std::max(1.0f, size.y / 1440.0f * 2.2f));
+        return;
+    }
+    wuwa_sheet::CardState state;
+    const bool held=m_cards->value() && held_card(state);
+    if (held) {
+        m_card_last=state;
+        m_tip_until.store(0);
+    }
+    if (!card_visible()) {
+        wuwa_menu_host::draw_step_overlay(list,size);
+        return;
+    }
+    if (!held) state=m_pin_card->value() ? wuwa_sheet::CardState{} : m_card_last;
+    state.vr_controllers=vr_controllers;
+    state.view=view;
+    state.blur=m_stereo_dof->value();
+    state.hide_near=m_hide_near->value();
+    state.portal=setting_on("WindowMode_Enabled");
+    state.diorama=vr->is_diorama_enabled();
+    state.mouse_mode=m_adjust.value() || mode_warning_active();
+    state.first_person=m_camera->value()==3;
+    state.fixed_camera=m_camera->value()==1;
+    state.ui_hidden=!vr->is_gui_enabled();
+    state.pinned=m_pin_card->value();
+    wuwa_sheet::draw_card(list,size,ImGui::GetFont(),state);
+}
+
+std::string WuWaControlsComponent::run_status() const {
+    const auto totals = wuwa_run::totals();
+    const auto clock = wuwa_run::clock_text(totals.duration_ms), walking = wuwa_run::clock_text(totals.walking_ms);
+    const double km = totals.distance_cm / 100000.0;
+    if (wuwa_run::active())
+        return wuwa_ui::format("Run on: %s, walking %s, %.2f km in the game.", clock.c_str(), walking.c_str(), km);
+    if (wuwa_run::has_finished_run())
+        return wuwa_ui::format("Last run: %s, walking %s, %.2f km in the game.", clock.c_str(), walking.c_str(), km);
+    if (m_run_auto->value() && wuwa_run::treadmill_app.load())
+        return wuwa_l10n::translate(N_("Reality Runner is open: 10 seconds of walking starts a run."));
+    return wuwa_l10n::translate(N_("No run yet. Start one here, or open Reality Runner and walk."));
+}
