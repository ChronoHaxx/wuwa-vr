+// Diagnostic-only full-view comparison. Both completed FSceneViews retain
+// their own matrices and temporal states. Only their two proven pass fields
+// are changed, across the two synchronous submissions, then restored. This
+// does NOT touch the scene-view constructor or make a lasting profile change.
+class FullPairScope {
+public:
+    FullPairScope(const void* family, void* first, void* second, int32_t count) {
+        if (!full_view_enabled() || !compatible() || count != 2 || !family ||
+            !first || !second || first == second) return;
+        const auto a = reinterpret_cast<uintptr_t>(first), b = reinterpret_cast<uintptr_t>(second);
+        uintptr_t af{}, bf{};
+        if (!checked::read(a, af) || !checked::read(b, bf) || af != reinterpret_cast<uintptr_t>(family) || bf != af) return;
+        std::array<uintptr_t, 4> fields{};
+        for (size_t i = 0; i < pass_offsets.size(); ++i) {
+            if (a > UINTPTR_MAX - pass_offsets[i] || b > UINTPTR_MAX - pass_offsets[i]) return;
+            fields[i] = a + pass_offsets[i]; fields[i + 2] = b + pass_offsets[i];
+            if (!writable_field(fields[i]) || !writable_field(fields[i + 2])) return;
+        }
+        patch.emplace(fields, std::array<uint32_t, 4>{2, 2, 3, 3}, 0,
+            &checked::read<uint32_t>, &write_field);
+        if (!patch->applied()) {
+            faulted = true;
+            spdlog::error("[WuWaShadow] full-view comparison validation/write failed; disabling further writes");
+            return;
+        }
+        ++valid_pairs;
+        last_valid_ms = GetTickCount64();
+        ++full_applied;
+    }
+    bool active() const { return patch && patch->applied(); }
+    ~FullPairScope() {
+        if (!patch) return;
+        if (!patch->restore()) {
+            faulted = true;
+            spdlog::error("[WuWaShadow] full-view comparison restoration failed; disabling further writes");
+        } else if (patch->applied()) ++full_restored;
+    }
+    FullPairScope(const FullPairScope&) = delete;
+    FullPairScope& operator=(const FullPairScope&) = delete;
+private:
+    std::optional<wuwa_stereo::ScenePassTransaction> patch;
+};
+
+// Construct immediately before the second BeginRenderingViewFamily call and
+// destroy immediately after it. That call copies views for the render thread,
+// as required by the existing UEVR temporary view-count/target changes too.
+// The existing Native Stereo Fix Same Pass setting enables the verified fix.
+// A temporary comparison can override it; all code/view/write guards still apply.
+class PassScope {
+public:
+    PassScope(const void* family, const void* first, void* second, int32_t count, bool same_pass) {
+        configured_enabled = same_pass;
+        if (!compatible() || faulted.load() || count != 2 || first == nullptr ||
+            second == nullptr || first == second || family == nullptr) return;
+        const auto a = reinterpret_cast<uintptr_t>(first);
+        const auto b = reinterpret_cast<uintptr_t>(second);
+        uintptr_t af{}, bf{};
+        std::array<uint32_t, 2> av{}, bv{};
+        bool valid = checked::read(a, af) && checked::read(b, bf) &&
+            af == reinterpret_cast<uintptr_t>(family) && bf == af;
+        for (size_t i = 0; i < pass_offsets.size(); ++i) {
+            const bool fields_valid = checked::read_field(a, pass_offsets[i], av[i]) &&
+                checked::read_field(b, pass_offsets[i], bv[i]) && av[i] == 2 &&
+                (bv[i] == 3 || (bv[i] == 2 && early_configured.load())) &&
+                b <= UINTPTR_MAX - pass_offsets[i] && writable_field(b + pass_offsets[i]);
+            valid = fields_valid && valid;
+        }
+        valid = valid && bv[0] == bv[1];
+        if (!valid) {
+            ++invalid_pairs;
+            SPDLOG_INFO_EVERY_N_SEC(5, "[WuWaShadow] skipped pair: family_match={} pass1={}/{} pass2={}/{}",
+                af == reinterpret_cast<uintptr_t>(family) && bf == af, av[0], av[1], bv[0], bv[1]);
+            return;
+        }
+        ++valid_pairs;
+        last_valid_ms = GetTickCount64();
+        // The generic SDK inferred the wrong WuWa InitOptions state offset.
+        // Read the constructor-proven FSceneView +8 on this verified pair
+        // instead. State identity is evidence for the remaining culling issue,
+        // not permission to share or replace temporal/occlusion history.
+        const auto now = GetTickCount64();
+        auto next = next_state_sample.load(std::memory_order_relaxed);
+        if (now >= next && next_state_sample.compare_exchange_strong(next, now + 2000)) {
+            uintptr_t first_state{}, second_state{};
+            const bool first_ok = checked::read_field(a, 8, first_state);
+            const bool second_ok = checked::read_field(b, 8, second_state);
+            spdlog::info("[WuWaShadow] paired_view_state tick={} family={:x} first_view={:x} second_view={:x} first_read={} first_state={:x} second_read={} second_state={:x} same_nonnull_state={}",
+                now, reinterpret_cast<uintptr_t>(family), a, b, first_ok, first_state,
+                second_ok, second_state, first_ok && second_ok && first_state && first_state == second_state);
+        }
+        SPDLOG_INFO_EVERY_N_SEC(5, "[WuWaShadow] pair=2/2,{}/{} enabled={} valid={} invalid={} applied={} restored={} early_applied={}",
+            bv[0], bv[1], enabled(), valid_pairs.load(), invalid_pairs.load(), applied.load(), restored.load(), early_applied.load());
+        // Already corrected before game-side view setup. Do not restore this
+        // view to secondary or change its state pointers.
+        if (bv[0] == 2) return;
+        if (!enabled()) return;
+        view = b;
+        for (size_t i = 0; i < pass_offsets.size(); ++i) {
+            touched[i] = true; // also restore after a failed write/readback
+            if (!write_field(view + pass_offsets[i], 2)) {
+                faulted = true;
+                spdlog::error("[WuWaShadow] write failed; restoring and disabling further tests");
+                restore();
+                return;
+            }
+        }
+        complete = true;
+        ++applied;
+    }
+
+    ~PassScope() { restore(); }
+    PassScope(const PassScope&) = delete;
+    PassScope& operator=(const PassScope&) = delete;
+
+private:
+    void restore() {
+        bool ok = true;
+        for (size_t i = 0; i < pass_offsets.size(); ++i) {
+            if (!touched[i]) continue;
+            touched[i] = false;
+            uint32_t current{};
+            const auto address = view + pass_offsets[i];
+            // Do not overwrite an unexpected engine-side change.
+            const bool restored_field = checked::read(address, current) &&
+                (current == 3 || (current == 2 && write_field(address, 3)));
+            ok = restored_field && ok;
+        }
+        if (!ok) {
+            faulted = true;
+            spdlog::error("[WuWaShadow] restoration failed or engine changed pass; further writes disabled");
+        } else if (complete) {
+            ++restored;
+        }
+        complete = false;
+    }
+    uintptr_t view{};
+    std::array<bool, 2> touched{};
+    bool complete{};
+};
+
+// Copies the LOD inputs of the main pair's first view into the second. Only for the
+// verified main pair (first pass 2, second 3 or 2). Each write is read back.
+inline void lod_sync(bool enabled, const void* family, void* first, void* second, int32_t count) {
+    if (lod_sync_bypassed() || (!enabled && !lod_sync_active()) || !compatible() || faulted.load() || count != 2 || !family || !first || !second) return;
+    const auto a = reinterpret_cast<uintptr_t>(first), b = reinterpret_cast<uintptr_t>(second);
+    uint32_t pa{}, pb{};
+    if (!checked::read_field(a, 0xc90, pa) || !checked::read_field(b, 0xc90, pb) || pa != 2 || (pb != 3 && pb != 2)) return;
+    for (const auto offset : lod_sync_offsets) {
+        uint32_t value{};
+        if (!checked::read_field(a, offset, value) || !write_field(b + offset, value)) { ++lod_sync_failed; return; }
+    }
+    ++lod_sync_applied;
+}
+
+// Camera fades in both eyes. FSceneView OverlayColor (+0xc70: the PlayerCameraManager's FadeColor
+// with FadeAmount as alpha) and ColorScale (+0xc80) come from the camera manager only for the first
+// view; the second eye's default camera leaves them clear. So the game's fades reached the right eye
+// alone: black at login while the left eye already showed the world, white at story cuts. 3.7
+// offsets, from the view constructor (0x1454cb855..0x1454cb87b: init +0x120/+0x130/+0x140 to view
+// +0xc60/+0xc70/+0xc80, then the stereo pass +0xc90 that lod_sync checks). Verified main pair only;
+// values must be finite colours, and every write is read back.
+inline constexpr uint32_t overlay_sync_offset = 0xc70;
+inline constexpr size_t overlay_sync_floats = 8;
+// The constructor's OverlayColor and ColorScale stores (init +0x130/+0x140 -> view +0xc70/+0xc80),
+// checked on their own so a game patch that moves them disables only this copy.
+inline constexpr uint32_t overlay_code_rva = 0x54cbde4;
+inline constexpr std::array<uint8_t, 30> overlay_code{
+    0x41,0x0f,0x10,0x85,0x30,0x01,0x00,0x00, 0x0f,0x11,0x83,0x70,0x0c,0x00,0x00,
+    0x41,0x0f,0x10,0x85,0x40,0x01,0x00,0x00, 0x0f,0x11,0x83,0x80,0x0c,0x00,0x00};
+inline bool overlay_compatible() {
+    static const bool matched = [] {
+        const bool ok = compatible() && wuwa_self_port::code_matches(overlay_code_rva, overlay_code);
+        if (ok) spdlog::info("[WuWaShadow] camera fade fields matched; fades copied to the second eye");
+        else spdlog::error("[WuWaShadow] camera fade code check failed at {:x}; fades not copied", overlay_code_rva);
+        return ok;
+    }();
+    return matched;
+}
+inline void overlay_sync(const void* family, void* first, void* second, int32_t count) {
+    if (count != 2 || !family || !first || !second || faulted.load() || !overlay_compatible()) return;
+    const auto a = reinterpret_cast<uintptr_t>(first), b = reinterpret_cast<uintptr_t>(second);
+    uintptr_t fa{}, fb{};
+    uint32_t pa{}, pb{};
+    if (!checked::read_field(a, 0, fa) || !checked::read_field(b, 0, fb) ||
+        fa != reinterpret_cast<uintptr_t>(family) || fb != fa) return;
+    if (!checked::read_field(a, 0xc90, pa) || !checked::read_field(b, 0xc90, pb) || pa != 2 || (pb != 3 && pb != 2)) return;
+    if (!writable_span(b + overlay_sync_offset, overlay_sync_floats * sizeof(float))) { ++overlay_sync_failed; return; }
+    std::array<uint32_t, overlay_sync_floats> source{}, target{};
+    for (size_t i = 0; i < overlay_sync_floats; ++i) {
+        const auto offset = overlay_sync_offset + static_cast<uint32_t>(i * sizeof(float));
+        if (!checked::read_field(a, offset, source[i]) || !checked::read_field(b, offset, target[i])) { ++overlay_sync_failed; return; }
+        float value{};
+        std::memcpy(&value, &source[i], sizeof(value));
+        // RGB then fade amount (0..1), then the colour scale (never negative).
+        const bool fade_amount = i == 3, scale = i >= 4;
+        if (!std::isfinite(value) || value > 64.0f || value < (scale || fade_amount ? 0.0f : -1.0f) ||
+            (fade_amount && value > 1.0f)) { ++overlay_sync_rejected; return; }
+    }
+    if (source == target) return;
+    for (size_t i = 0; i < overlay_sync_floats; ++i) {
+        if (source[i] != target[i] &&
+            !write_field(b + overlay_sync_offset + static_cast<uint32_t>(i * sizeof(float)), source[i])) { ++overlay_sync_failed; return; }
+    }
+    ++overlay_sync_applied;
+}
+
+// Diagnostic only, opened by the WuWa test control `state_swap` for at most 60
+// seconds; inert otherwise. For one verified main pair, the two views exchange
+// their view-state pointers and get them back after both submissions. Construct
+// before the LOD probe's first snapshot and the first submission, so every probe
+// phase and both render copies see one assignment. Each eye then renders with
+// the other eye's state object (history, caches, registrations); no state is
+// copied or shared. Not combined with the other pass or order tests. A failed
+// write or restore disables every write in this module, like the pass scopes.
+class StateSwapScope {
+public:
+    StateSwapScope(const void* family, void* first, void* second, int32_t count) {
+        if (!state_swap_active()) return;
+        const auto a = reinterpret_cast<uintptr_t>(first), b = reinterpret_cast<uintptr_t>(second);
+        uintptr_t af{}, bf{};
+        std::array<uint32_t, 2> ap{}, bp{};
+        bool valid = ready() && compatible() && !faulted.load() && !test_active() && count == 2 &&
+            family != nullptr && a && b && a != b && a <= UINTPTR_MAX - 8 && b <= UINTPTR_MAX - 8 &&
+            checked::read(a, af) && checked::read(b, bf) &&
+            af == reinterpret_cast<uintptr_t>(family) && bf == af;
+        // Only the main eye pair: first view primary, second secondary or already early-primary.
+        for (size_t i = 0; valid && i < pass_offsets.size(); ++i) {
+            valid = checked::read_field(a, pass_offsets[i], ap[i]) && checked::read_field(b, pass_offsets[i], bp[i]) &&
+                ap[i] == 2 && (bp[i] == 3 || bp[i] == 2);
+        }
+        if (!valid) { ++swap_skipped; return; }
+        patch.emplace(a + 8, b + 8, &read_pointer, &write_pointer,
+            static_cast<wuwa_stereo::StateSwapTransaction::Mode>(swap_mode.load()));
+        if (patch->result() == wuwa_stereo::StateSwapTransaction::Result::write_failed) {
+            fail(patch->restore() ? "write failed; rolled back" : "write failed; rollback not confirmed");
+            patch.reset();
+            return;
+        }
+        if (!patch->applied()) { ++swap_skipped; patch.reset(); return; }
+        ++swap_applied;
+        SPDLOG_INFO_EVERY_N_SEC(5, "[WuWaShadow] state swap applied ({}): first_view={:x} second_view={:x} states {:x}/{:x}",
+            swap_mode_names[static_cast<size_t>(swap_mode.load())], a, b, patch->original(0), patch->original(1));
+    }
+    bool active() const { return patch && patch->applied(); }
+    ~StateSwapScope() {
+        if (!patch) return;
+        if (patch->restore()) ++swap_restored;
+        else fail("restore failed or the engine changed a state pointer");
+    }
+    StateSwapScope(const StateSwapScope&) = delete;
+    StateSwapScope& operator=(const StateSwapScope&) = delete;
+private:
+    static void fail(const char* what) {
+        faulted = true;
+        swap_until = 0;
+        spdlog::error("[WuWaShadow] state swap {}; further writes disabled", what);
+    }
+    std::optional<wuwa_stereo::StateSwapTransaction> patch;
+};
+} // namespace wuwa_shadow
