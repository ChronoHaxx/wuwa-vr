+        generation, stage, (uintptr_t)chain, (uint32_t)window.hwnd_result,
+        (uintptr_t)window.hwnd, (uint32_t)desc_result, (uintptr_t)desc_hwnd, (uintptr_t)desc_hwnd);
+}
