diff --git a/src/space_math.h b/src/space_math.h
new file mode 100644
--- /dev/null
+++ b/src/space_math.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <openxr/openxr.h>
+
+// All poses below are rigid transforms with unit OpenXR quaternions.
+namespace simspace {
+inline XrPosef IdentityPose() { return {{0, 0, 0, 1}, {0, 0, 0}}; }
+
+inline XrQuaternionf MultiplyQuaternions(const XrQuaternionf& a, const XrQuaternionf& b) {
+    return {a.w*b.x + a.x*b.w + a.y*b.z - a.z*b.y,
+            a.w*b.y - a.x*b.z + a.y*b.w + a.z*b.x,
+            a.w*b.z + a.x*b.y - a.y*b.x + a.z*b.w,
+            a.w*b.w - a.x*b.x - a.y*b.y - a.z*b.z};
+}
+
+inline XrVector3f RotateVectorByQuaternion(const XrQuaternionf& q, const XrVector3f& v) {
+    const auto r = MultiplyQuaternions(MultiplyQuaternions(q, {v.x, v.y, v.z, 0}), {-q.x, -q.y, -q.z, q.w});
+    return {r.x, r.y, r.z};
+}
+
+inline XrPosef ComposePose(const XrPosef& parent, const XrPosef& child) {
+    const auto r = RotateVectorByQuaternion(parent.orientation, child.position);
+    return {MultiplyQuaternions(parent.orientation, child.orientation),
+            {parent.position.x + r.x, parent.position.y + r.y, parent.position.z + r.z}};
+}
+
+inline XrPosef InversePose(const XrPosef& pose) {
+    const XrQuaternionf inverse{-pose.orientation.x, -pose.orientation.y, -pose.orientation.z, pose.orientation.w};
+    return {inverse, RotateVectorByQuaternion(inverse, {-pose.position.x, -pose.position.y, -pose.position.z})};
+}
+
+inline XrPosef RelativePose(const XrPosef& worldPose, const XrPosef& baseWorldPose) {
+    return ComposePose(InversePose(baseWorldPose), worldPose);
+}
+
+inline XrPosef ReferenceWorldPose(XrReferenceSpaceType type, const XrPosef& offset, const XrPosef& head) {
+    // In this simulator LOCAL and STAGE share a fixed origin. VIEW follows the head.
+    return type == XR_REFERENCE_SPACE_TYPE_VIEW ? ComposePose(head, offset) : offset;
+}
+} // namespace simspace
diff --git a/tests/space_math_tests.cpp b/tests/space_math_tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/space_math_tests.cpp
@@ -0,0 +1,54 @@
+#include "space_math.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <initializer_list>
+
+namespace {
+void Near(float a, float b) {
+    if (!std::isfinite(a) || std::abs(a - b) > 0.00002f) {
+        std::fprintf(stderr, "pose mismatch: %.8f != %.8f\n", a, b);
+        std::exit(1);
+    }
+}
+void SamePose(const XrPosef& a, const XrPosef& b) {
+    Near(a.position.x, b.position.x); Near(a.position.y, b.position.y); Near(a.position.z, b.position.z);
+    // Compare rotated axes, because q and -q express the same orientation.
+    for (auto axis : {XrVector3f{1,0,0}, XrVector3f{0,1,0}, XrVector3f{0,0,1}}) {
+        const auto x = simspace::RotateVectorByQuaternion(a.orientation, axis);
+        const auto y = simspace::RotateVectorByQuaternion(b.orientation, axis);
+        Near(x.x, y.x); Near(x.y, y.y); Near(x.z, y.z);
+    }
+}
+}
+int main() {
+    using namespace simspace;
+    const auto identity = IdentityPose();
+    const float q = std::sqrt(0.5f);
+    // Independent expected positions: 90-degree yaw turns eye X displacement toward -Z.
+    const XrPosef head{{0,q,0,q}, {3,1.7f,-4}};
+    const XrPosef left{{0,0,0,1}, {-0.032f,0,0}};
+    const auto worldEye = ComposePose(head, left);
+    Near(worldEye.position.x, 3); Near(worldEye.position.y, 1.7f); Near(worldEye.position.z, -3.968f);
+    SamePose(RelativePose(worldEye, ReferenceWorldPose(XR_REFERENCE_SPACE_TYPE_VIEW, identity, head)), left);
+    SamePose(RelativePose(worldEye, ReferenceWorldPose(XR_REFERENCE_SPACE_TYPE_STAGE, identity, head)), worldEye);
+
+    const XrPosef offset{{q,0,0,q}, {0,0.4f,-0.2f}};
+    const auto viewOffset = ReferenceWorldPose(XR_REFERENCE_SPACE_TYPE_VIEW, offset, head);
+    SamePose(ComposePose(viewOffset, RelativePose(worldEye, viewOffset)), worldEye);
+    const auto stageOffset = ReferenceWorldPose(XR_REFERENCE_SPACE_TYPE_STAGE, offset, head);
+    SamePose(stageOffset, offset);
+    SamePose(ComposePose(stageOffset, RelativePose(head, stageOffset)), head);
+    SamePose(RelativePose(viewOffset, viewOffset), identity);
+    SamePose(ComposePose(InversePose(head), head), identity);
+
+    // Walking/tilting the head must never leak into eye offsets requested in VIEW.
+    for (float a : {-1.2f, 0.0f, 0.7f}) {
+        const XrPosef movingHead{{std::sin(a/2),0,0,std::cos(a/2)}, {a*2,1.7f+a,a-5}};
+        for (float x : {-0.032f,0.032f}) {
+            const XrPosef eye{{0,0,0,1}, {x,0,0}};
+            SamePose(RelativePose(ComposePose(movingHead, eye), movingHead), eye);
+        }
+    }
+    std::puts("OpenXR reference-space pose tests passed");
+}
