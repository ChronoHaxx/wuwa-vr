+static bool SpaceWorldPose(XrSpace space, float yaw, float pitch, float roll, XrPosef& pose, bool& tracked) {
+    tracked = true;
+    const XrPosef head{QuatFromYawPitchRoll(yaw, pitch, roll), g_headPos};
+    if (const auto it = g_referenceSpaces.find(space); it != g_referenceSpaces.end()) {
+        pose = simspace::ReferenceWorldPose(it->second.type, it->second.poseInRef, head);
+        return true;
+    }
+    if (const auto it = g_controllerSpaces.find(space); it != g_controllerSpaces.end()) {
+        pose = simspace::IdentityPose();
+        if (it->second == 0) { tracked = false; return true; }
+        const auto& ctrl = it->second == 1 ? g_leftController : g_rightController;
+        tracked = ctrl.isTracking;
