+bool WuWaControlsComponent::auto_cinema_active() const {
+    return auto_cinema_presentation() != wuwa_auto_cinema::Presentation::none;
+}
+wuwa_auto_cinema::Presentation WuWaControlsComponent::auto_cinema_presentation() const {
+    return m_cinema_presentation.load();
+}
+void WuWaControlsComponent::advance_auto_cinema(bool runtime_ready, bool story_ready, bool character_ready) {
+    std::scoped_lock lock{m_cinema_mutex};
+    // Apply expiry on a game-frame boundary, never independently between eye
+    // getter calls. A fully stalled game thread holds its last presentation
+    // until the next tick; that tick releases a stale producer before rendering.
+    const auto now = GetTickCount64();
+    if (!runtime_ready) m_cinema_lease.invalidate();
+    m_cinema_presentation.store(m_cinema_lease.presentation(now));
+    if (!story_ready) m_story_lease.invalidate();
+    m_story_scene.store(m_story_lease.presentation(now) != wuwa_auto_cinema::Presentation::none);
+    if (!character_ready) m_showroom_lease.invalidate();
+    m_character_screen.store(m_showroom_lease.presentation(now) != wuwa_auto_cinema::Presentation::none);
+    // Whatever changed the full VR layout (the HUD page, a story scene, a step's
+    // setting), the game's UI scaler keeps the old size until a layout refresh.
+    // The stereo screen and mono theatre refresh on their own way back.
+    const int8_t layout = VR::get()->is_wuwa_ui_window_size_active() ? 1 : 0;
+    if (m_layout_seen >= 0 && layout != m_layout_seen && !VR::get()->is_using_2d_screen() && !VR::get()->is_using_mono_theatre())
+        m_hud_aspect_request.set("true");
+    m_layout_seen = layout;
+}
+std::string WuWaControlsComponent::auto_cinema_status() const {
+    std::scoped_lock lock{m_cinema_mutex};
+    const auto now = GetTickCount64();
+    const auto state = m_cinema_presentation.load() != wuwa_auto_cinema::Presentation::none && !m_cinema_lease.active(now) ?
+        N_("Automatic lease expired; restoration waits for the next game tick") : m_cinema_lease.state(now);
+    return wuwa_l10n::translate(state) + ". " + m_cinema_signal +
+        " [detection " + std::to_string(static_cast<int>(std::round(m_cinema_detection_ms))) + " ms]";
+}
+void WuWaControlsComponent::reset_auto_cinema() {
+    std::scoped_lock lock{m_cinema_mutex};
+    // Keeps the producer generation: the story-scene detector may be running.
+    m_cinema_lease.clear();
+    m_picture_seen_ms = 0;
+    m_cinema_presentation.store(wuwa_auto_cinema::Presentation::none);
+    m_cinema_signal = "Detector has not reported";
+    m_cinema_detection_ms = 0;
+}
+void WuWaControlsComponent::override_auto_cinema() {
+    std::scoped_lock lock{m_cinema_mutex};
+    m_cinema_lease.manual();
+    m_cinema_presentation.store(wuwa_auto_cinema::Presentation::none);
+}
+std::string WuWaControlsComponent::CinemaValue::get() const {
+    if (kind == 1) return "lease-v4";
+    if (kind == 2) return owner.auto_cinema_status();
+    if (kind == 3) return VR::get()->is_using_mono_theatre() ? "true" : "false";
+    // v2 (test 3i): explicit "on" / "off" as well as "toggle", for the view cycle.
+    if (kind == 4 || kind == 5) return "effective-v2";
+    if (kind == 6) return VR::get()->is_using_2d_screen() ? "true" : "false";
+    if (kind == 7) return VR::get()->wants_story_scene_layout() ? "true" : "false";
+    if (kind == 8) return VR::get()->wants_character_screen_layout() ? "true" : "false";
+    std::scoped_lock lock{owner.m_cinema_mutex};
+    return std::to_string(owner.m_cinema_lease.generation());
+}
+void WuWaControlsComponent::CinemaValue::set(const std::string& text) {
+    if (kind == 4 || kind == 5) {
+        const auto mono = kind == 4;
+        const auto now = mono ? VR::get()->is_using_mono_theatre() : VR::get()->is_using_2d_screen();
+        const auto want = text == "toggle" ? !now : text == "on" ? true : text == "off" ? false : now;
+        if (text != "toggle" && text != "on" && text != "off") return;
+        if (mono) VR::get()->set_mono_theatre_manually(want);
+        else VR::get()->set_stereo_screen_manually(want);
+        return;
+    }
+    if (kind > 1 || text.size() > 512) return;
+    try {
+        if (kind == 0) {
+            std::scoped_lock lock{owner.m_cinema_mutex};
+            if (text == "start") owner.m_cinema_lease.start();
+            else if (text.starts_with("stop:")) {
+                size_t consumed{};
+                const auto generation = std::stoull(text.substr(5), &consumed);
+                if (consumed == text.size() - 5) owner.m_cinema_lease.stop(generation);
+            }
+            return;
+        }
+        const auto sample = nlohmann::json::parse(text);
+        if (!sample.is_object() || sample.value("version", 0) != 1) return;
+        const auto token = sample.value("generation", std::string{});
+        if (token.empty() || token.size() > 20 || token.find_first_not_of("0123456789") != std::string::npos) return;
+        const auto generation = std::stoull(token);
+        const auto world = sample.value("world", std::string{});
+        const auto active = sample.value("active", -1), hold = sample.value("hold", -1), known = sample.value("known", -1);
+        const auto detail = sample.value("detail", std::string{});
+        const auto elapsed = sample.value("elapsed_ms", 0.0);
+        if (world.empty() || world.size() > 32 || world.find_first_not_of("0123456789") != std::string::npos ||
+            active < 0 || active > 31 || hold < 0 || hold > 31 || known < 0 || known > 31 ||
+            detail.size() > 240 || !std::isfinite(elapsed) || elapsed < 0 || elapsed > 50) return;
+        std::scoped_lock lock{owner.m_cinema_mutex};
+        const bool cinema = VR::get()->is_auto_cinema_enabled(), story = VR::get()->wants_story_scene_layout();
+        const bool character = VR::get()->wants_character_screen_layout();
+        // The cinema lease's generation fences old producers for all three leases.
+        if ((!cinema && !story && !character) || generation != owner.m_cinema_lease.generation()) return;
+        const auto now = GetTickCount64();
+        // The plot flag alone, for the story camera nudge.
+        if (known & wuwa_auto_cinema::plot) owner.m_plot_seen_ms.store((active & wuwa_auto_cinema::plot) ? now : 0);
+        bool accepted = false;
+        const wuwa_auto_cinema::Bits bits{static_cast<uint8_t>(active), static_cast<uint8_t>(hold), static_cast<uint8_t>(known)};
+        if (cinema) {
+            const auto c = wuwa_auto_cinema::cinema_bits(bits);
+            if (c.active & wuwa_auto_cinema::picture) owner.m_picture_seen_ms = now;
+            const bool picture_recent = owner.m_picture_seen_ms && now - owner.m_picture_seen_ms < 1200;
+            const auto presentation = wuwa_auto_cinema::choose(c, owner.m_cinema_lease.seen_sources(), picture_recent,
+                VR::get()->auto_story_presentation(), VR::get()->auto_picture_presentation());
+            accepted = owner.m_cinema_lease.sample(generation, world, c.active, c.hold, c.known, presentation, now);
+        }
+        if (story) {
+            // Any presentation marks the scene; only the layout reads this lease.
+            const auto b = wuwa_auto_cinema::story_bits(bits);
+            if (!owner.m_story_lease.generation()) owner.m_story_lease.start();
+            accepted = owner.m_story_lease.sample(owner.m_story_lease.generation(), world, b.active, b.hold, b.known,
+                wuwa_auto_cinema::Presentation::stereo_screen, now) || accepted;
+        }
+        if (character) {
+            // As the story lease: any presentation marks the screen; only the layout reads it.
+            const auto b = wuwa_auto_cinema::showroom_bits(bits);
+            if (!owner.m_showroom_lease.generation()) owner.m_showroom_lease.start();
+            accepted = owner.m_showroom_lease.sample(owner.m_showroom_lease.generation(), world, b.active, b.hold, b.known,
+                wuwa_auto_cinema::Presentation::stereo_screen, now) || accepted;
+        }
+        if (accepted) {
+            owner.m_cinema_signal = detail;
+            owner.m_cinema_detection_ms = elapsed;
+        }
+    } catch (const std::exception&) { /* malformed or obsolete producer: expire naturally */ }
+}
+
+std::string WuWaControlsComponent::StoryValue::get() const {
+    if (kind == 0) {
+        // Read only while the game has focus and UEVR is closed; the keys still reach the game.
+        if (!game_focused()) return "0";
+        if (GetAsyncKeyState(VK_HOME) & 0x8000) return "2";
+        const bool nearer = (GetAsyncKeyState(VK_PRIOR) & 0x8000) != 0, back = (GetAsyncKeyState(VK_NEXT) & 0x8000) != 0;
+        return nearer == back ? "0" : nearer ? "1" : "-1";
+    }
+    if (kind == 1) {
+        // The detector samples ten times a second; a second and a half without one is no plot.
+        const auto seen = owner.m_plot_seen_ms.load();
+        return seen && GetTickCount64() - seen < 1500 ? "true" : "false";
+    }
+    std::scoped_lock lock{mutex};
+    return now_text;
+}
