// Version information for the original launcher stub. Licence scope: see LICENSE.md.
#include <winver.h>

1 ICON "wuwa-vr.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE | VS_FF_PRIVATEBUILD
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ChronoHaxx (unofficial fan project)"
            VALUE "FileDescription", "WuWa VR Launcher (unofficial)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "WuWaVRLauncher"
            VALUE "LegalCopyright", "Copyright (c) 2026 ChronoHaxx. Bundled components keep their own terms."
            VALUE "OriginalFilename", "WuWa VR Launcher.exe"
            VALUE "PrivateBuild", "Private test package; not a public release"
            VALUE "ProductName", "WuWa VR Launcher"
            VALUE "ProductVersion", "0.1.0-private"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
