diff --git a/src/utility/WuWaConsoleReadPolicy.hpp b/src/utility/WuWaConsoleReadPolicy.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..0c5272f704c9d6d0d3e4c13c4cbed2f97a9a4247
--- /dev/null
