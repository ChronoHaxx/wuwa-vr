+struct CallbackGuard {
+    State& s;
+    DWORD error{GetLastError()};
+    explicit CallbackGuard(State& value) : s{value} { AcquireSRWLockShared(&s.callbacks); }
+    ~CallbackGuard() { ReleaseSRWLockShared(&s.callbacks); SetLastError(error); }
+};
