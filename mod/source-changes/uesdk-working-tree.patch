 #include <utility/String.hpp>
 
 #include "UObjectArray.hpp"
@@ -241,7 +242,31 @@ UActorComponent* AActor::add_component_by_class(UClass* uclass, bool deferred) {
 
     this->process_event(func, params.data());
 
-    return *(UActorComponent**)(params.data() + ret_offset);
+    auto result = *(UActorComponent**)(params.data() + ret_offset);
+
+    // The fallback below was previously only reachable when AddComponentByClass
+    // could not be FOUND. If the UFunction exists but the call yields nothing,
+    // there was no second chance and the caller just saw a null component.
+    //
+    // Wuthering Waves 2.6.5.0 hits exactly that: the UFunction resolves, the
+    // actor spawns, and process_event returns null every time - 14242 of 14242
+    // attempts on 2026-09-06, which left the native-stereo scene capture unable
+    // to exist and the right eye black. The param blob built above assumes a
+    // stock AddComponentByClass signature and a stock FTransform layout; a
+    // modified engine only has to disagree about either for this to fail
+    // silently. spawn_object + FinishAddComponent does not depend on that
+    // signature at all, so try it before giving up.
+    if (result == nullptr) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            spdlog::warn("[AActor] AddComponentByClass returned null; falling back to spawn_object path");
+        }
+
+        return add_component_by_class_ex(uclass, deferred);
+    }
+
+    return result;
 }
 
